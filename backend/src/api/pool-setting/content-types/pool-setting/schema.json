{
  "kind": "collectionType",
  "collectionName": "pool_settings",
  "info": {
    "singularName": "pool-setting",
    "pluralName": "pool-settings",
    "displayName": "Pool Settings",
    "description": "Per-academy pool configuration — pH, chlorine, temperature target ranges + alert tolerance. Drives the colour status on PoolInspection records. Compliant with Brazilian pool legislation defaults (pH 7.2–7.8, chlorine 1–3 mg/L)."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "academy": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::academy.academy",
      "inversedBy": "poolSettings"
    },
    "phMin": {
      "type": "decimal",
      "default": 7.2
    },
    "phMax": {
      "type": "decimal",
      "default": 7.8
    },
    "chlorineMin": {
      "type": "decimal",
      "default": 1
    },
    "chlorineMax": {
      "type": "decimal",
      "default": 3
    },
    "temperatureMin": {
      "type": "decimal",
      "default": 28
    },
    "temperatureMax": {
      "type": "decimal",
      "default": 31
    },
    "alertTolerance": {
      "type": "decimal",
      "default": 0.2
    },
    "inspectionTimes": {
      "type": "json"
    }
  }
}
